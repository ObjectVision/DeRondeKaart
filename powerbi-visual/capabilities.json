{
  "dataRoles": [
    {
      "name": "longitude",
      "displayName": "Lengtegraad (X)",
      "description": "WGS84 longitude for point features",
      "kind": "GroupingOrMeasure"
    },
    {
      "name": "latitude",
      "displayName": "Breedtegraad (Y)",
      "description": "WGS84 latitude for point features",
      "kind": "GroupingOrMeasure"
    },
    {
      "name": "geometry",
      "displayName": "Geometrie (WKT)",
      "description": "Well-Known Text geometry column (POINT/LINESTRING/POLYGON, incl. MULTI*). Takes precedence over Lengtegraad/Breedtegraad.",
      "kind": "GroupingOrMeasure"
    },
    {
      "name": "tooltips",
      "displayName": "Knopinfo",
      "description": "Extra fields carried along as feature properties",
      "kind": "GroupingOrMeasure"
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "longitude" } },
            { "for": { "in": "latitude" } },
            { "for": { "in": "geometry" } },
            { "for": { "in": "tooltips" } }
          ],
          "dataReductionAlgorithm": { "top": { "count": 30000 } }
        }
      }
    }
  ],
  "objects": {
    "map": {
      "properties": {
        "appUrl": { "type": { "text": true } },
        "layersLeft": { "type": { "text": true } },
        "layersRight": { "type": { "text": true } },
        "autoZoom": { "type": { "bool": true } }
      }
    },
    "pointStyle": {
      "properties": {
        "fillColor": { "type": { "fill": { "solid": { "color": true } } } },
        "radius": { "type": { "numeric": true } },
        "opacity": { "type": { "numeric": true } }
      }
    },
    "lineStyle": {
      "properties": {
        "color": { "type": { "fill": { "solid": { "color": true } } } },
        "width": { "type": { "numeric": true } },
        "opacity": { "type": { "numeric": true } }
      }
    },
    "polygonStyle": {
      "properties": {
        "fillColor": { "type": { "fill": { "solid": { "color": true } } } },
        "outlineColor": { "type": { "fill": { "solid": { "color": true } } } },
        "outlineWidth": { "type": { "numeric": true } },
        "opacity": { "type": { "numeric": true } }
      }
    }
  },
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": ["https://data.woonzorglimburg.nl", "http://localhost:5173"]
    }
  ],
  "supportsEmptyDataView": true,
  "supportsLandingPage": false
}
