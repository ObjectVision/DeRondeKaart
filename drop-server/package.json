{
  "name": "northwake-drop-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "E2E-encrypted upload-only drop service: browsers seal files to an admin-held public key; the server stores ciphertext it cannot read",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-force-exit \"dist-test/test/*.test.js\"",
    "page:vendor": "node -e \"const fs=require('fs');fs.mkdirSync('page/vendor',{recursive:true});for(const [s,d] of [['node_modules/libsodium/dist/modules/libsodium.js','page/vendor/libsodium.js'],['node_modules/libsodium-wrappers/dist/modules/libsodium-wrappers.js','page/vendor/libsodium-wrappers.js']])fs.copyFileSync(s,d);console.log('page/vendor populated')\""
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "libsodium-wrappers": "^0.7.15",
    "@types/libsodium-wrappers": "^0.7.14",
    "typescript": "~5.9.3"
  }
}
