{
  "layers": [
    {
      "id": "gemeente",
      "name": "Wijken Limburg",
      "source": "/cbs_wijken_limburg.arrow",
      "format": "geoarrow",
      "geometryType": "polygon",
      "geostyler": {
        "name": "Wijken Limburg",
        "rules": [
          {
            "name": "Maastricht",
            "filter": ["==", "WK_CODE", "WK093500"],
            "symbolizers": [{ "kind": "Fill", "color": "#e41a1c", "outlineColor": "#333333", "outlineWidth": 1 }]
          },
          {
            "name": "Heerlen",
            "filter": ["==", "WK_CODE", "WK088200"],
            "symbolizers": [{ "kind": "Fill", "color": "#377eb8", "outlineColor": "#333333", "outlineWidth": 1 }]
          },
          {
            "name": "Overig",
            "symbolizers": [{ "kind": "Fill", "color": "#4daf4a", "outlineColor": "#999999", "outlineWidth": 0.5 }]
          }
        ]
      },
      "style": {
        "opacity": 0.8
      }
    },
    {
      "id": "example-polygons",
      "name": "Example Polygons",
      "source": "https://raw.githubusercontent.com/opengeospatial/geoparquet/main/examples/example.parquet",
      "format": "parquet",
      "geometryType": "polygon",
      "style": {
        "color": [255, 69, 0, 150],
        "opacity": 0.8,
        "filled": true,
        "stroked": true,
        "lineWidth": 1
      }
    },
    {
      "id": "example-mvt",
      "name": "OpenMapTiles",
      "source": "https://demotiles.maplibre.org/tiles/{z}/{x}/{y}.pbf",
      "format": "mvt",
      "style": {
        "color": [50, 150, 50, 120],
        "opacity": 0.6,
        "filled": true,
        "stroked": true,
        "lineWidth": 1
      }
    },
    {
      "id": "WZW5",
      "name": "WZW5 test",
      "source": "https://tiles.mapgallery.io/woonzorgwijzer5/v1/public/layers/HGJGD/{z}/{x}/{y}.pbf",
      "format": "mvt",
      "sourceLayer": "HGJGD2024",
      "geostyler": {
        "name": "WZW5",
        "rules": [
        {
          "name": "minder dan 1.5%",
          "filter": ["==", "Class", 1],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#4275b5",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0
            }
          ]
        },
        {
          "name": "1,5 - 2,0%",
          "filter": ["==", "Class", 2],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#849ebd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 1
            }
          ]
        },
        {
          "name": "2,0 - 2,5%",
          "filter": ["==", "Class", 3],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#c6cfbd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "2,5 - 3,0%",
          "filter": ["==", "Class", 4],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ffffbd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "3,0 - 3,5%",
          "filter": ["==", "Class", 5],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ffba84",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "3,5 - 4,0%",
          "filter": ["==", "Class", 6],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ef7552",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "4% of meer",
          "filter": ["==", "Class", 7],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#d62c21",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        }
        ]
      },
      "style": {
        "opacity": 0.8
      }
    },
    {
      "id": "example-cog",
      "name": "Example COG",
      "source": "https://maplibre.org/maplibre-gl-js/docs/assets/cog.tif",
      "format": "cog",
      "style": {
        "opacity": 0.8
      }
    }
  ]
}
