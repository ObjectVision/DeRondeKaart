    {
      "id": "loopafstand_ov",
      "name": "Loopafstand OV",
      "source": "https://data.woonzorglimburg.nl/parquet/loopafstand_ov_2026_test.parquet",
      "format": "parquet",
      "geometryType": "polygon",
      "geostyler": {
        "name": "loopafstand in meter",
        "rules": [
          {
            "name": "minder dan 500",
            "filter": ["<", "afstand", 500],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#61BE7B",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          },
          {
            "name": "500 tot 750",
            "filter": ["&&", [">=", "afstand", 500], ["<", "afstand", 750]],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#A0D392",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          },
          {
            "name": "750 tot 1000",
            "filter": ["&&", [">=", "afstand", 750], ["<", "afstand", 1000]],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#FDEAB6",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          },
          {
            "name": "1000 tot 1250",
            "filter": ["&&", [">=", "afstand", 1000], ["<", "afstand", 1250]],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#F8D8AF",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          },
          {
            "name": "1250 tot 1500",
            "filter": ["&&", [">=", "afstand", 1250], ["<", "afstand", 1500]],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#FFAF92",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          },
          {
            "name": "meer dan 1500",
            "filter": [">=", "afstand", 1500],
            "symbolizers": [
              {
                "kind": "Fill",
                "color": "#FF6024",
                "outlineWidth": 0,
                "outlineOpacity": 0.2
              }
            ]
          }
        ]
      },
      "style": {
        "opacity": 0.8
      },
      "featureinfo": {
        "template": "<div><b>Loopafstand apotheek: [[ apotheek ]] m</b></div>"
      }
    },
