    {
      "id": "WZW5",
      "name": "WZW5 test",
      "source": "https://tiles.mapgallery.io/woonzorgwijzer5/v1/public/layers/HGJGD/{z}/{x}/{y}.pbf",
      "format": "mvt",
      "sourceLayer": "HGJGD2024",
      "geostyler": {
        "name": "WZW5",
        "rules": [
        {
          "name": "minder dan 1.5%",
          "filter": ["==", "Class", 1],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#4275b5",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0
            }
          ]
        },
        {
          "name": "1,5 - 2,0%",
          "filter": ["==", "Class", 2],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#849ebd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 1
            }
          ]
        },
        {
          "name": "2,0 - 2,5%",
          "filter": ["==", "Class", 3],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#c6cfbd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "2,5 - 3,0%",
          "filter": ["==", "Class", 4],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ffffbd",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "3,0 - 3,5%",
          "filter": ["==", "Class", 5],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ffba84",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "3,5 - 4,0%",
          "filter": ["==", "Class", 6],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#ef7552",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        },
        {
          "name": "4% of meer",
          "filter": ["==", "Class", 7],
          "symbolizers": [
            {
              "kind": "Fill",
              "color": "#d62c21",
              "outlineColor": "black",
              "outlineWidth": 0,
              "outlineOpacity": 0.7
            }
          ]
        }
        ]
      },
