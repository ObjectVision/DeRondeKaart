# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Data directory: ignore everything except Python scripts
data/**
!data/**/
!data/**/*.py

# Secrets: the drop-server admin keypair (tools/drop_keygen.py) and any env
# files must never be committed. The private key decrypts ALL received drops.
*.key
.env
.env.*
/.vs

# Metainfo generator INPUTS. `data/**` above ignores this whole tree apart
# from Python, but these are source rather than data — the spreadsheet every
# document is written in, the fragment templates and the images they point at.
# They used to live under scripts/ and be versioned; without these four lines
# moving them here would quietly stop tracking them.
!data/meta/README.md
!data/meta/*/metadata.xlsx
!data/meta/template/**
!data/meta/handmatig/**
!data/meta/afbeeldingen/**
# ...except the dated working copies of somebody's spreadsheet, which the
# generator skips as well.
data/meta/metainformatie_concept_*/metadata.xlsx

# Metainfo generator OUTPUT — a mirror of what the fileserver holds, rebuilt by
# `npm run metainfo` and uploaded from there. The published documents are not
# versioned at all: they are content rather than code, regenerated whenever the
# spreadsheet changes. Everything needed to rebuild them IS versioned, above.
data/meta/*/resultaten/
# LibreOffice's lock file, recreated every time the spreadsheet is opened.
.~lock.*#
