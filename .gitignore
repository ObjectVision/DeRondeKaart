# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Data directory: ignore everything except Python scripts
data/**
!data/**/
!data/**/*.py

# Secrets: the drop-server admin keypair (tools/drop_keygen.py) and any env
# files must never be committed. The private key decrypts ALL received drops.
*.key
.env
.env.*
/.vs

# Metainfo generator output. The spreadsheet, generator and templates are
# versioned; these two directories are rebuilt from them by `npm run metainfo`,
# and the copy the app actually serves is committed under public/data/meta.
# Tracking them too would put the same document in three places on every edit.
scripts/metainfo/resultaten/
scripts/metainfo/fragmenten/
# LibreOffice's lock file, recreated every time the spreadsheet is opened.
.~lock.*#
