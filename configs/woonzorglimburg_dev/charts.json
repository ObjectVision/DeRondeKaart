          "4": { "label": "laagopgeleid gepensioneerd", "color": "#F4B1E0" },
          "5": { "label": "onzekere werkenden", "color": "#FFB62B" },
          "6": { "label": "precariaat", "color": "#BD0100" },
          "7": { "label": "gemend bovenlaag", "color": "#002471" },
          "8": { "label": "gemengd middengroep", "color": "#66CDA6" },
          "9": { "label": "jonge kansrijken en onzekere werkenden", "color": "#BDD39B" },
          "10": { "label": "onzekere werkenden en precariaat", "color": "#DC6E20" },
          "11": { "label": "gemengde welvaart", "color": "#488F57" }
