          "5": { "label": "onzekere werkenden" },
          "6": { "label": "precariaat" },
          "7": { "label": "gemend bovenlaag" },
          "8": { "label": "gemengd middengroep" },
          "9": { "label": "jonge kansrijken en onzekere werkenden" },
          "10": { "label": "onzekere werkenden en precariaat" },
          "11": { "label": "gemengde welvaart" }
        }
      },
      "aggregation": "count",
      "format": "number"
    },
    {
