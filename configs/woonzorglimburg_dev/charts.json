{
  "charts": [
    {
      "id": "sdk_verdeling_donut",
      "title": "Sociaal dominante klasse — verdeling",
      "type": "donut",
      "data": {
        "groupBy": "data",
        "labels": {
          "0": { "label": "werkende bovenlaag", "color": "#1229DE" },
          "1": { "label": "jonge kansrijken", "color": "#A7FF74" },
